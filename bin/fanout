#!/usr/bin/env python3
"""Set N agents going on N tasks that will not collide.

    bin/fanout                 plan 5 agents, change nothing
    bin/fanout 3               plan 3
    bin/fanout --theme perf    all from one lane
    bin/fanout --go            claim the tasks and write the prompts to .fanout/
    bin/fanout --cloud --go    also create Conductor cloud workspaces and start them
    bin/fanout --cloud --go --commit  also authorize local commits in those workspaces

Picks tasks greedily: highest value first, skipping any task whose predicted files
overlap one already picked. File prediction is a heuristic (see bin/_predict.py) and
errs toward over-caution, which is the safe direction here - it separates tasks that
might have collided rather than risking two agents in one file.

Prints a ready-to-paste prompt per agent. With --go it also claims each task, so a
second run of bin/fanout picks a different set.
"""

import argparse
import importlib.machinery
import importlib.util
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MAC_CONDUCTOR = Path.home() / "Library/Application Support/com.conductor.app/bin/conductor"

PROMPT = """Read AGENTS.md and docs/MODERNIZATION.md, then run bin/setup.

Your task is {id}. {claim_instruction}

{text}

Follow docs/MODERNIZATION.md.{kind_advice}

Work only on this task. If you spot something else wrong, add a line to
docs/braindump.txt and carry on - do not fix it.

Other agents are working in this repo right now. These files are yours to edit:

{files}

Reading anything else is fine, and necessary test files are always allowed. Before
editing another production file outside that list, stop and report it because another
agent may be working there. The list is a best guess, so being wrong is expected.

{delivery}

Stop when bin/verify is green. Then tell me what the problem actually was, what your
test proves, and anything you found but deliberately left alone.
"""

BUG_ADVICE = (
    " This is a bug, so write the failing test first - if you cannot make a test "
    "fail you have not found the bug yet."
)
REFACTOR_ADVICE = (
    " This is a refactor, so behaviour must not change. If the area has no tests, "
    "add characterization tests pinning current behaviour in their own commit first."
)


def load_module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def claimed_ids():
    result = subprocess.run([str(ROOT / "bin/claim"), "--list"],
                            capture_output=True, text=True, cwd=ROOT)
    return {line.split()[0] for line in result.stdout.splitlines() if line.startswith("T-")}


def pick(tasks, predict, count, theme, risk):
    """Greedy: best task first, skip anything sharing a predicted file."""
    held = claimed_ids()
    pool = [t for t in tasks if not t["done"] and t["id"] not in held]
    if theme:
        pool = [t for t in pool if t["theme"] == theme]
    if risk:
        pool = [t for t in pool if t["risk"] == risk]
    # Pinned first, then bugs, then low risk (quick wins), then stable by id.
    order = {"low": 0, "medium": 1, "high": 2}
    pool.sort(key=lambda t: (not t["pinned"], t["theme"] != "bug", order[t["risk"]], t["id"]))

    chosen, taken = [], set()
    for task in pool:
        files = set(predict(task["text"], limit=6))
        if files & taken:
            continue
        chosen.append({**task, "files": sorted(files)})
        taken |= files
        if len(chosen) == count:
            break
    return chosen


def build_prompt(task, commit, claimed):
    if task["theme"] == "bug":
        advice = BUG_ADVICE
    elif task["theme"] in ("arch", "views", "types"):
        advice = REFACTOR_ADVICE
    else:
        advice = ""
    files = "\n".join(f"  {f}" for f in task["files"]) or "  (work it out from the task)"
    if commit:
        delivery = "Commit to the branch bin/claim suggests. Do not push or open a PR."
    else:
        delivery = "Do not commit, push, or open a PR unless the user asks."
    if claimed:
        claim_instruction = (
            "The fanout coordinator already claimed it; do not claim it again. "
            "Run bin/claim --where to confirm the coordination mode."
        )
    else:
        claim_instruction = f"Claim it first:  bin/claim {task['id']}"
    return PROMPT.format(
        id=task["id"], text=task["text"], kind_advice=advice,
        files=files, delivery=delivery, claim_instruction=claim_instruction,
    )


def conductor_cli():
    found = shutil.which("conductor")
    if found:
        return found
    if MAC_CONDUCTOR.exists():
        return str(MAC_CONDUCTOR)
    return None


def git_output(*args):
    result = subprocess.run(
        ["git", *args], capture_output=True, text=True, cwd=ROOT, check=True,
    )
    return result.stdout.strip()


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("count", nargs="?", type=int, default=5)
    parser.add_argument("--theme")
    parser.add_argument("--risk", choices=["low", "medium", "high"])
    parser.add_argument("--go", action="store_true",
                        help="claim the tasks and write prompts to .fanout/")
    parser.add_argument("--cloud", action="store_true",
                        help="with --go, also create Conductor cloud workspaces")
    parser.add_argument("--commit", action="store_true",
                        help="tell launched agents to commit (never push or open a PR)")
    args = parser.parse_args()

    tasks_mod = load_module("tasks_cli", ROOT / "bin/tasks")
    predict_mod = load_module("predict", ROOT / "bin/_predict.py")

    chosen = pick(tasks_mod.load(), predict_mod.predict, args.count, args.theme, args.risk)
    if not chosen:
        sys.exit("nothing available - everything matching is claimed or done")
    if len(chosen) < args.count:
        print(f"note: could only find {len(chosen)} non-colliding tasks, not {args.count}\n")

    print(f"{len(chosen)} agents, no overlap in their predicted edit files:\n")
    for i, task in enumerate(chosen, 1):
        print(f"  {i}. {task['id']}  [{task['theme']}/{task['risk']}]  {task['text'][:72]}")
        for f in task["files"]:
            print(f"       {f}")
    print()

    if not args.go:
        print("Files are predicted from the task text, so treat them as a starting point.")
        print("Agents are told to flag before editing anything outside their list.")
        print("Dry run. Nothing claimed. Re-run with --go to claim and write prompts.\n")
        for i, task in enumerate(chosen, 1):
            print("=" * 72)
            print(f"AGENT {i} - workspace name: {task['theme']}-{task['id'][2:].lower()}")
            print("=" * 72)
            print(build_prompt(task, args.commit, claimed=False))
        return 0

    outdir = ROOT / ".fanout"
    if outdir.exists():
        shutil.rmtree(outdir)
    outdir.mkdir()

    for i, task in enumerate(chosen, 1):
        claim = subprocess.run([str(ROOT / "bin/claim"), task["id"]],
                               capture_output=True, text=True, cwd=ROOT)
        if claim.returncode != 0:
            print(f"  ! {task['id']} was claimed by someone else, skipping")
            continue
        name = f"{task['theme']}-{task['id'][2:].lower()}"
        path = outdir / f"{i}-{name}.txt"
        path.write_text(build_prompt(task, args.commit, claimed=True), encoding="utf-8")
        print(f"  claimed {task['id']} -> {path.relative_to(ROOT)}")

        if args.cloud:
            conductor = conductor_cli()
            if not conductor:
                print("    ! conductor CLI not found")
                continue
            try:
                repo_url = git_output("remote", "get-url", "origin")
                branch = git_output("branch", "--show-current")
            except subprocess.CalledProcessError:
                print("    ! could not determine repository URL and branch")
                continue
            if not branch:
                print("    ! detached HEAD; check out the branch workspaces should use")
                continue
            created = subprocess.run(
                [conductor, "workspace", "create", "--repo-url", repo_url,
                 "--branch", branch, "--name", name,
                 "--message-file", str(path), "--env", "GATHERLING_CLAIMS=remote"],
                capture_output=True, text=True, cwd=ROOT)
            if created.returncode == 0:
                print(f"    cloud workspace started: {created.stdout.strip().splitlines()[-1:]}")
            else:
                print(f"    ! cloud create failed: {created.stderr.strip().splitlines()[:1]}")

    print(f"\nPrompts in {outdir.relative_to(ROOT)}/. For local Conductor workspaces:")
    print("  make a workspace per file, name it after the file, paste the contents in.")
    print("\nRelease a claim if you change your mind:  bin/claim --release T-XXXXXX")
    return 0


if __name__ == "__main__":
    sys.exit(main())
