<h2>Calculate Ratings</h2>
<form action="admincp.php" method="post">
    <input type="hidden" name="view" value="calc_ratings">
    <table class="form c">
        <tr>
            <td class="buttons">
                <input class="inputbutton" type="submit" name="action" value="Re-Calculate All Ratings">
            </td>
        </tr>
        <tr>
            <td>
                Select a rating to Re-Calculate:
                {{#formatDropMenuR}}{{> dropMenu}}{{/formatDropMenuR}}
                <input class="inputbutton" type="submit" name="action" value="Re-Calculate By Format">
            </td>
        </tr>
    </table>
</form>

