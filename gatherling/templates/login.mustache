{{#loginFailed}}
    <p class="c error">Incorrect username or password. Please try again.</p>
{{/loginFailed}}
{{#message}}
    <div class="c error">{{message}}</div>
{{/message}}
<form action="login.php" method="post">
    <table class="form" cellpadding="3">
        <tr>
            <th>Gatherling Username</th>
            <td><input id="username" class="inputbox" type="text" name="username" value="{{username}}" tabindex="1"></td>
        </tr>
        <tr>
            <th>Gatherling Password</th>
            <td><input id="password" class="inputbox" type="password" name="password" tabindex="2"></td>
        </tr>
        <tr>
            <td>&nbsp;</td>
        </tr>
        <tr>
            <td colspan="2" class="buttons">
                {{#target}}
                    <input type="hidden" name="target" value="{{target}}">
                {{/target}}
                <input class="inputbutton btn-primary" type="submit" name="mode" value="Log In" tabindex="3">
                {{#discordId}}
                    <button class="inputbutton discordlogin" name="mode" value="Log In with Discord" tabindex="4">
                        <i class="fab fa-discord"></i> Log In with Discord
                    </button>
                {{/discordId}}
                <br>
                Please <a href="register.php">Click Here</a> if you need to register.<br>
                <a href="forgot.php">Forgot your password?</a>
            </td>
        </tr>
    </table>
</form>
