<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="gatherling" />
        <directory name="tests" />
        <ignoreFiles allowMissingFiles="true">
            <!-- Gitignored and machine-specific; its contents differ per developer. -->
            <file name="gatherling/config.php" />
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin" />
    </plugins>
    <issueHandlers>
        <MissingConstructor errorLevel="suppress">
            <errorLevel type="suppress">
                <!-- PDO::FETCH_CLASS cannot use constructors -->
                <file name="gatherling/Models/*Dto.php" />
            </errorLevel>
        </MissingConstructor>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress" errorLevel="suppress">
                <!-- Psalm can't see that we use of properties in mustache templates -->
                <file name="gatherling/Views/*.php" />
                <file name="gatherling/Views/Pages/*.php" />
                <file name="gatherling/Views/Components/*.php" />
                <!-- Psalm can't trace Dto instantiation via PDO::FETCH_CLASS -->
                <file name="gatherling/Models/*Dto.php" />
                <file name="tests/Support/TestDto.php" />
            </errorLevel>
        </PossiblyUnusedProperty>
    </issueHandlers>
</psalm>